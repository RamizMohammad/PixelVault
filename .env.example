# ── Admin panel: Google sign-in ───────────────────────────────────────────────
# OAuth 2.0 Client ID (type: Web application) from Google Cloud Console.
# Add your panel's origin (e.g. https://pixelvault.example.com) under
# "Authorized JavaScript origins". No client secret is needed.
GOOGLE_CLIENT_ID=425038484637-77ik9pqg1dka6vmdjqvp1qo98l5uspov.apps.googleusercontent.com

# Only these Google accounts can sign in (comma-separated)
ADMIN_ALLOWED_EMAILS=dev.mohammadramiz@gamil.com

# Signs the session cookie. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=3pRCfosU5Fd56Xb_uKszpi_IqNaZS4pi9JeczRfjd5MM1qdSANEtXzUyQfcTpWrW

# How long a sign-in lasts
ADMIN_SESSION_DAYS=7

# true when served over https (production). Set false only for http://localhost testing.
COOKIE_SECURE=true

# ── Public API ────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
MAX_IMAGE_PIXELS=60000000
CORS_ORIGINS=*
